GITHUB_TOKEN=

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

NUXT_DATABASE_URL=

# OpenPanel product analytics (self-hosted at https://events.geoql.in)
# Client ID is public (baked into the browser bundle at build time).
NUXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Client secret authenticates server-side track calls (server/utils/openpanel.ts).
# In production it is a Worker secret. Never commit it or expose it to the client.
NUXT_OPENPANEL_CLIENT_SECRET=
